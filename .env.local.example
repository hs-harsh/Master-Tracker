# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT ENVIRONMENT
#
#   cp .env.local.example .env.local
#   npm run db:up && npm run db:reset && npm run dev
#
# .env.local is gitignored and loaded BEFORE .env, so everything set here wins.
# Anything left out here falls through to .env. Leaving DATABASE_URL out would
# fall through to the Railway PRODUCTION database — the guard in
# server/db/guard.js exits(1) if that happens, but set it anyway.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Points at the docker-compose Postgres. Host port is 5433, not 5432, so it can
# never collide with a system Postgres install.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/investment_tracker

# ── Ports ────────────────────────────────────────────────────────────────────
# SERVER_PORT is read BEFORE PORT. Some tooling injects PORT=5173 into the
# environment; because dotenv never overrides a real env var, that used to move
# the API onto Vite's port. SERVER_PORT is not injected by anything, so it wins.
SERVER_PORT=3001

# ── App ──────────────────────────────────────────────────────────────────────
# 'development' keeps the server from serving the built client — Vite does that
# in dev. It is also one of the two signals the DB guard uses.
NODE_ENV=development

# CORS origin for the Vite dev server.
CLIENT_URL=http://localhost:5173

# Any long random string works locally. Changing it invalidates existing
# local logins; it does not need to match production.
JWT_SECRET=local_dev_secret_not_used_anywhere_else

# ── Optional ─────────────────────────────────────────────────────────────────
# Reminder emails (habits / meal plan / stale assets) are OFF locally: cron only
# starts in a deployed environment. Set to 1 only if you are deliberately
# testing the cron path — it sends REAL email to any profile with an address.
# ENABLE_CRON=1

# Escape hatch for the DB guard. With this set, a non-local DATABASE_URL is
# allowed (a warning banner still prints). Do not set it casually — it is what
# stands between `npm run dev` and the production database.
# ALLOW_REMOTE_DB=1

# SMTP — only needed if you are testing OTP login emails or cron reminders.
# Without these, sign-in codes are printed to the server console instead.
# SMTP_USER=
# SMTP_PASS=

# Claude API — Expense Analyser, backtest rule parsing, meal/workout AI.
# Those features return an error without a key; the rest of the app is fine.
# ANTHROPIC_API_KEY=sk-ant-...

# Cron timezone (default Asia/Kolkata).
# TZ=Asia/Kolkata
